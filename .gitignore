# ---------------------------------------------------------------------------
# Test content must NEVER be pulled by others.
# Everything matching these rules stays local and is never committed/pushed.
# ---------------------------------------------------------------------------
*_test.go
/tests/
**/testdata/
*.test
coverage.out
coverage.html

# Go build artifacts
*.exe
*.dll
*.so
*.dylib
*.a
/bin/
/dist/

# Docs site (Vite+ / React) — never commit deps or build output
node_modules/
docs-site/dist/
docs-site/.vite/
*.local

# Optional codegraph233 project-local binaries/index (reprovision on demand)
.codegraph233/
.codegraph233.json

# Editor / OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/

# Generated reports / decision artifacts (local only)
/output/
# Workspace memory (local only)
/.workbuddy/
